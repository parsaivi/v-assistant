<?xml version="1.0" encoding="utf-8"?>
<!-- 4×2. The hero line needs the width to hold a Persian meeting title beside
     a time and a gap without wrapping; the height is two rows of small print
     under it. `updatePeriodMillis` is 30 minutes because that is Android's
     floor — anything smaller is silently rounded up — and it is the refresh
     that still happens when `VService` has been killed. The live one is the
     event stream: see `Widgets.onEvent`. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:resizeMode="horizontal|vertical"
    android:minResizeWidth="180dp"
    android:minResizeHeight="70dp"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:description="@string/widget_today_description"
    android:widgetCategory="home_screen" />
