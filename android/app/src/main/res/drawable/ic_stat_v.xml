<?xml version="1.0" encoding="utf-8"?>
<!-- The status-bar icon. Android tints these to a flat silhouette, so the
     aperture's gradient and its two ring colours are dropped here and it
     reduces to two rings and a dot — the same reduction the brief specifies
     for 16px. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#FFFFFF">
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.6"
        android:fillColor="#00000000"
        android:pathData="M12,2.8 a9.2,9.2 0 1,0 0.01,0 z" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M12,8.6 a3.4,3.4 0 1,0 0.01,0 z" />
</vector>
